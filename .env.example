# Copy to .env and fill values, or run: ./scripts/fetch_secrets.sh
WORK_ROOT=/opt/work
SITES_YAML=/opt/work/sites.yaml
PORT=8090

GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-key.json
GOOGLE_PLACES_API_KEY=
KRCAMPUS_GOOGLE_MAPS_API_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FLASK_SECRET_KEY=
ALLOWED_EMAILS=your@email.com

# Work Hub content pipeline profile (defaults in run_pipeline):
# CONTENT_PIPELINE_WITH_IMAGES=1   # 0 → skip Places/Imagen (⑥ 탭만 쓸 때)
# CONTENT_PIPELINE_WITH_GIT=0      # content 탭에서는 git 안 함 (③ Git 탭)
# CONTENT_PIPELINE_WITH_DEPLOY=0   # content 탭에서는 Cloud Build 안 함 (④ 배포 탭)
# CONTENT_LIMIT=3
# GUIDE_LIMIT=2
# CONTENT_PIPELINE_WITH_JA=1       # krcampus JA step

# LLM — Claude Code CLI (claude.ai Pro/Max subscription).
# Do NOT use ANTHROPIC_API_KEY here unless you want separate API billing.
# CLAUDE_BIN=/opt/work/_hub/node_modules/.bin/claude
# CLAUDE_TIMEOUT_SEC=180
# Model tiers: light=JSON/topic/SEO/Ship · heavy=long MD articles
# CLAUDE_MODEL_LIGHT=haiku
# CLAUDE_MODEL_HEAVY=sonnet
# GSC_SEO_URL_CAP=5              # max Claude SEO calls per GSC run
# Claude /usage dashboard cache (seconds); avoid polling oauth/usage too often
# CLAUDE_USAGE_CACHE_SEC=300
# GitHub Ship tab (issues/PR) uses local `gh` CLI — run: gh auth login
# CLAUDE_CREDENTIALS=~/.claude/.credentials.json
# CLAUDE_HOME=/Users/you   # if hub runs as another user but Claude login is here
# (optional) keep GEMINI_API_KEY only for site Imagen/image scripts, not okadmin LLM
# GEMINI_API_KEY=

# AI spend from GCP Billing → BigQuery (dashboard)
# GCP_PROJECT_ID=starful-258005
# BILLING_BQ_DATASET=billing_new
# BILLING_BQ_CACHE_SEC=3600
# Budgets in billing currency. Alert categories default ≈ ¥3000 (USD≈¥/150).
# GEMINI_BUDGET_YEN=3000
# IMAGEN_BUDGET_YEN=3000
# BANANA_BUDGET_YEN=3000
# PLACES_BUDGET_YEN=3000
# TOTAL_BUDGET_YEN=0
# GEMINI_BUDGET_USD=20
# IMAGEN_BUDGET_USD=20
# BANANA_BUDGET_USD=20
# PLACES_BUDGET_USD=20
# TOTAL_BUDGET_USD=0
# USD_YEN_RATE=150

# GSC API (Search Console) — gsc-token.json = OAuth 클라이언트, 아래는 사용자 토큰
GSC_CLIENT_SECRETS=gsc-token.json
GSC_TOKEN_PATH=gsc-oauth-user.json
# GSC_HTTP_TIMEOUT_SEC=25
# GA4_RPC_TIMEOUT_SEC=25
# GA4_REPORT_RETRIES=2
# GA4_RPC_CONCURRENCY=3
# ANALYTICS_OVERVIEW_TIMEOUT_SEC=90

# Local only (8090 OAuth redirect 미등록 시 1 권장)
LOCAL_DEV_AUTH=1
DEV_LOGIN_EMAIL=your@email.com
